# Copy to .env (which is gitignored) and fill in.
#
# NOTE: nothing loads this file automatically. Settings are read straight from the
# environment. To use it:
#
#   server : uvicorn --env-file .env sect.core.app:create_app --factory
#   shell  : export $(grep -v '^#' .env | xargs)     # then `sect ...` works too
#
# ---------------------------------------------------------------------------
# sect-core (the server). Only these two are required.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/sect?sslmode=require
SECT_MASTER_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-32

# Optional, shown with their defaults.
# SECT_DEFAULT_LEASE_SECONDS=900
# SECT_MAX_LEASE_SECONDS=86400
# SECT_DEFAULT_MAX_ATTEMPTS=3
# SECT_MAX_POLL_LIMIT=100
# SECT_DB_POOL_MIN=1
# SECT_DB_POOL_MAX=5
# SECT_AUTO_MIGRATE=true
# LOG_LEVEL=INFO

# Set true ONLY when DATABASE_URL points at a transaction-mode pooler such as
# Neon's pooled endpoint or PgBouncer. It disables asyncpg's prepared-statement
# cache, which silently breaks under transaction pooling.
# SECT_DB_PGBOUNCER=false

# ---------------------------------------------------------------------------
# A disciple. This is all a worker repo needs in its secrets.
# ---------------------------------------------------------------------------
SECT_URL=https://sect-core.onrender.com
SECT_TOKEN=sect_d_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
